# 复制到服务器的 /root/my-docker-apps/.env，chmod 600。
# docker compose 用它做变量替换，java-app 通过 env_file 读取。

# Cloudflare Tunnel token（从现有 compose 的 cloudflared command 中取出，
# 改由 .env 注入，避免 token 明文写在 compose 里）。
CLOUDFLARE_TUNNEL_TOKEN=

# 生产 profile：关闭开发身份桩、日志降为 INFO。
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080
ADMIN_STUB_ENABLED=false
ALLOW_INSECURE_DEV_STUB=false
# 管理员强制 TOTP 二次验证；默认 false。开启前先确保管理员已绑定，
# 否则管理员访问后台会收到 1009。
REQUIRE_ADMIN_2FA=false

# 管理员初始密码：首次启动会创建/重置 admin 密码。
# 生产环境若仍使用种子默认密码，启动会拒绝。
TRAVELMAPPER_ADMIN_USERNAME=admin
TRAVELMAPPER_ADMIN_PASSWORD=请替换为强密码

# 必填：AesCryptoService 启动时强制校验。
# 生成：openssl rand -base64 32
TRAVELMAPPER_AES_KEY=
# 必填：至少 32 字节。生成：openssl rand -hex 32
TRAVELMAPPER_JWT_SECRET=

# ---- MySQL（compose 内部服务名 mysql，不映射宿主端口）----
DB_ROOT_PASSWORD=请替换为强密码
DB_NAME=travelmapper
DB_USERNAME=travelmapper
DB_PASSWORD=请替换为强密码
# java-app 的 DB_URL 由 compose environment 覆盖为 jdbc:mysql://mysql:3306/...
DB_HOST=mysql
DB_PORT=3306

# ---- Redis（compose 内部服务名 redis，无密码）----
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ---- 邮件 ----
# 推荐在后台「配置 → 邮件 SMTP」填写（存 DB，热加载）。
# 这里的值只在 DB 未配置时作为兜底。
MAIL_ENABLED=false
MAIL_HOST=smtp.resend.com
MAIL_PORT=587
MAIL_USERNAME=resend
MAIL_PASSWORD=
MAIL_FROM=noreply@example.com
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true
# 生产必须 false，否则验证码会写进日志。
MAIL_LOG_VERIFICATION_CODES=false

# ---- 备份（scripts/backup.sh）----
# 生产必须 true + 容器名，脚本通过 docker exec 执行 mysqldump。
DB_IN_CONTAINER=true
DB_CONTAINER=mysql-db
BACKUP_DIR=./backups
# OSS（S3 兼容）上的备份位置
S3_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
S3_BUCKET=请替换为备份 Bucket
S3_ACCESS_KEY=请替换为 AccessKey
S3_SECRET_KEY=请替换为 SecretKey
S3_PREFIX=backups
S3_MODE=auto
# 备份含邮箱与密码哈希，必须加密。
BACKUP_ENCRYPTION=required
# age 公钥（age1...）或 gpg 收件人，二选一
BACKUP_AGE_RECIPIENT=
BACKUP_GPG_RECIPIENT=
BACKUP_ALLOW_PLAINTEXT=false

# ---- 故障提醒（飞书机器人）----
ALERT_ENABLED=true
ALERT_WEBHOOK_URL=
ALERT_MIN_INTERVAL_SECONDS=300
ALERT_HEALTH_CRON="0 */5 * * * *"