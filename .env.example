# Copy to .env and replace secrets. Never commit .env.
SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8080
ADMIN_STUB_ENABLED=true

# Base64-encoded 32-byte key. Generate with: openssl rand -base64 32
TRAVELMAPPER_AES_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=
# At least 32 bytes. Generate with: openssl rand -hex 32
TRAVELMAPPER_JWT_SECRET=dev-only-jwt-secret-change-me-0123456789abcdef0123456789abcdef

# Mail: disabled by default; verification links are written to email_token in the DB.
MAIL_ENABLED=false
MAIL_HOST=localhost
MAIL_PORT=25
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@travelmapper.local
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS=false

# MySQL (docker compose defaults)
DB_URL=jdbc:mysql://127.0.0.1:3306/travelmapper?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
DB_USERNAME=travelmapper
DB_PASSWORD=travelmapper
DB_NAME=travelmapper
DB_HOST=127.0.0.1
DB_PORT=3306

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Object storage (app values are stored in sys_config; these are for backup/compose)
S3_ENDPOINT=http://127.0.0.1:9000
S3_BUCKET=travelmapper
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_PREFIX=backups

# Backup
BACKUP_DIR=./backups
DB_IN_CONTAINER=false
DB_CONTAINER=tm-mysql
