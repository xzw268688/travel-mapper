# Copy to .env and replace secrets. Never commit .env.
SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8080
# Local only. Production must use SPRING_PROFILES_ACTIVE=prod and keep this false.
ADMIN_STUB_ENABLED=true
ALLOW_INSECURE_DEV_STUB=true
# Production: set a strong password; startup refuses the seeded default in prod.
TRAVELMAPPER_ADMIN_USERNAME=admin
TRAVELMAPPER_ADMIN_PASSWORD=

# Base64-encoded 32-byte key. Generate with: openssl rand -base64 32
TRAVELMAPPER_AES_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=
# At least 32 bytes. Generate with: openssl rand -hex 32
TRAVELMAPPER_JWT_SECRET=dev-only-jwt-secret-change-me-0123456789abcdef0123456789abcdef

# Mail: disabled by default; verification links are written to email_token in the DB.
MAIL_ENABLED=false
MAIL_HOST=localhost
MAIL_PORT=25
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@travelmapper.local
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS=false
# Local only: print verification codes to logs when SMTP is disabled.
# Production must keep this false; otherwise codes leak into logs.
MAIL_LOG_VERIFICATION_CODES=true

# MySQL (docker compose defaults)
DB_URL=jdbc:mysql://127.0.0.1:3306/travelmapper?useUnicode=true&characterEncoding=utf8&connectionTimeZone=Asia/Shanghai&forceConnectionTimeZoneToSession=true&useSSL=false&allowPublicKeyRetrieval=true
DB_USERNAME=travelmapper
DB_PASSWORD=travelmapper
DB_NAME=travelmapper
DB_HOST=127.0.0.1
DB_PORT=3306

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Object storage (app values are stored in sys_config; these are for backup/compose)
S3_ENDPOINT=http://127.0.0.1:9000
S3_BUCKET=travelmapper
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_PREFIX=backups

# Backup
BACKUP_DIR=./backups
DB_IN_CONTAINER=false
DB_CONTAINER=tm-mysql
# required | age | gpg | off
BACKUP_ENCRYPTION=required
# age 公钥，如 age1...
BACKUP_AGE_RECIPIENT=
# gpg 收件人 key id / 邮箱
BACKUP_GPG_RECIPIENT=
# 仅本地验证允许明文备份
BACKUP_ALLOW_PLAINTEXT=false

# 故障提醒（飞书机器人 Webhook）
# 推荐在后台「配置 → 故障提醒」中配置；以下为数据库未配置时的兜底
# 留空时只写日志，不发送外部请求
ALERT_ENABLED=true
ALERT_WEBHOOK_URL=
ALERT_MIN_INTERVAL_SECONDS=300
ALERT_HEALTH_CRON="0 */5 * * * *"
